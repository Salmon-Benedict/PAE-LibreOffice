<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE script:module PUBLIC "-//OpenOffice.org//DTD OfficeDocument 1.0//EN" "module.dtd">
<script:module xmlns:script="http://openoffice.org/2000/script" script:name="Module1" script:language="StarBasic"><![CDATA[
' Served LOCALLY by PAE Bird.app now (see PolySwift/Poly/Poly/LocalServer.
' swift), not the internet -- no API key needed for a localhost-only
' listener. Existing already-installed copies of this add-in (the old,
' internet-based build) are unaffected -- LibreOffice extensions don't
' self-update, so this only changes what a fresh .oxt install gets.
' https, not http -- LocalServer.swift serves TLS with a per-machine
' certificate CertificateManager.swift generates and trusts on first
' launch (curl here needs that trust in place, or -k would be needed).
Const PAE_API_URL = "https://127.0.0.1:51823"

' Standardizes on the same general /compute route (cmd/arg/expression ->
' result) the Python UNO add-in (pae_bird.py) and Excel's client both use,
' rather than PAE-API's separate /solve, /expand, /factor, etc. legacy
' routes -- those exist there only for older callers' backward
' compatibility; the local server doesn't carry that burden.
Function PAECallAPI(sCmd As String, sExpression As String, Optional sArg As String) As String
    If IsMissing(sArg) Then sArg = ""
    Dim sJSON As String
    sJSON = "{""cmd"":""" & sCmd & """,""arg"":""" & sArg & """,""expression"":""" & sExpression & """}"
    Dim iFile As Integer
    iFile = FreeFile()
    Open "/tmp/pae_payload.json" For Output As #iFile
    Print #iFile, sJSON
    Close #iFile
    iFile = FreeFile()
    Open "/tmp/pae_call.sh" For Output As #iFile
    Print #iFile, "#!/bin/bash"
    Print #iFile, "/usr/bin/curl -s -X POST '" & PAE_API_URL & "/compute' -H 'Content-Type: application/json' --data @/tmp/pae_payload.json -o /tmp/pae_result.json"
    Close #iFile
    Shell "/bin/bash", 1, "/tmp/pae_call.sh", True
    Dim sLine As String, sResult As String
    iFile = FreeFile()
    Open "/tmp/pae_result.json" For Input As #iFile
    Do While Not EOF(iFile)
        Line Input #iFile, sLine
        sResult = sResult & sLine
    Loop
    Close #iFile
    Dim n As Long, e As Long
    n = InStr(sResult, """result"":""")
    If n > 0 Then
        n = n + 10
        e = InStr(n, sResult, """")
        If e > n Then : PAECallAPI = Mid(sResult, n, e - n) : Exit Function : End If
    End If
    If sResult = "" Then
        PAECallAPI = "Error: couldn't reach PAE Bird -- make sure the PAE Bird app is open on this Mac."
    Else
        PAECallAPI = "Error: " & sResult
    End If
End Function

Function PAE_SOLVE(expression As String) As String
    PAE_SOLVE = PAECallAPI("solve", expression)
End Function

Function PAE_EXPAND(expression As String) As String
    PAE_EXPAND = PAECallAPI("expand", expression)
End Function

Function PAE_FACTOR(expression As String) As String
    PAE_FACTOR = PAECallAPI("factor", expression)
End Function

Function PAE_DIFFERENTIATE(expression As String, Optional variable As String) As String
    If IsMissing(variable) Then variable = "x"
    PAE_DIFFERENTIATE = PAECallAPI("differentiate", expression, variable)
End Function

Function PAE_INTEGRATE(expression As String, Optional variable As String) As String
    If IsMissing(variable) Then variable = "x"
    PAE_INTEGRATE = PAECallAPI("integrate", expression, variable)
End Function

Sub ShowPaeBirdSettings()
    MsgBox "PAE Bird runs entirely on this Mac now -- no account or API key needed." & Chr(13) & Chr(13) & _
           "Just keep the PAE Bird app open while using this spreadsheet.", 64, "PAE Bird"
End Sub
]]></script:module>
